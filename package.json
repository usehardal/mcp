{
  "name": "usehardal-mcp",
  "version": "1.0.0",
  "description": "Remote MCP server for Hardal analytics over Beacon OAuth — query Nebula reports from Claude and ChatGPT",
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "start": "bun run ./src/index.ts",
    "dev": "bun --watch ./src/index.ts",
    "build": "bun build --compile --minify-whitespace --minify-syntax --target bun --outfile server ./src/index.ts",
    "lint": "eslint .",
    "type-check": "bunx tsc --noEmit",
    "test": "bun test",
    "service-identity:generate": "bun run ./scripts/generate-service-identity.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "hardal",
    "analytics",
    "oauth"
  ],
  "license": "MIT",
  "author": "Hardal",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usehardal/mcp.git"
  },
  "bugs": {
    "url": "https://github.com/usehardal/mcp/issues"
  },
  "homepage": "https://usehardal.com",
  "dependencies": {
    "@azure/identity": "^4.13.2",
    "@azure/keyvault-secrets": "^4.11.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "elysia": "latest",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "bun-types": "latest",
    "eslint": "^10.5.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.62.0"
  },
  "bun": {
    "target": "bun"
  }
}
