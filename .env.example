NODE_ENV="development"
PORT="1922"

# Beacon OAuth: public issuer advertised in metadata, and where this server calls Beacon.
OAUTH_ISSUER="http://localhost:1919"
BEACON_API_URL="http://localhost:1919"

# This server's resource identifier (token A audience) and the Reports API audience (token B).
MCP_RESOURCE="http://localhost:1922"
REPORTS_API_RESOURCE="http://localhost:1919/v1"

# Report requests per authenticated user per minute, per MCP replica (minimum 2).
MCP_REPORTS_RATE_LIMIT_PER_MINUTE="300"
# Report requests per tenant per minute, per MCP replica; the authoritative cross-replica quota lives in Beacon (DEV-4347).
MCP_REPORTS_TENANT_RATE_LIMIT_PER_MINUTE="600"
# End-to-end budget per tool call, kept below Beacon's 25 s Sirius timeout; spending it returns deadline-exceeded.
MCP_TOOL_DEADLINE_MS="20000"
# Timeout for Beacon discovery, introspection and token-exchange calls, which start before the tool budget exists.
MCP_BEACON_AUTH_TIMEOUT_MS="5000"
# How long a tool call may wait for an in-flight slot before failing with tenant-busy.
MCP_CONCURRENCY_WAIT_MS="2000"
# Concurrent tool calls admitted per tenant and per user, per replica (tenant cap mirrors Sirius' per-process slots).
MCP_TENANT_MAX_IN_FLIGHT="3"
MCP_USER_MAX_IN_FLIGHT="2"
# Largest Reports API response body the server reads; larger answers fail with response-too-large (2 MiB).
MCP_UPSTREAM_BODY_LIMIT_BYTES="2097152"
# Largest inbound POST / body the server accepts; larger requests get HTTP 413 (1 MiB).
MCP_MAX_REQUEST_BODY_BYTES="1048576"
MCP_REPORT_SELECTION_KEY=""

# MCP service identity (private_key_jwt) for introspection and token exchange.
SERVICE_CLIENT_ID="hardal-mcp"
# Local dev only: path to the private JWK generated by service-identity:generate.
SERVICE_PRIVATE_JWK_PATH="keys/private.jwk.json"
# Production: read the private key from Azure Key Vault instead of a file.
# SERVICE_PRIVATE_JWK_VAULT_URL="https://hardal-vault.vault.azure.net/secrets/hardal-mcp-service-key"
# Usage analytics: tool-call metadata (never arguments or report data) to PostHog, off unless enabled with a token.
POSTHOG_ENABLED="false"
POSTHOG_PROJECT_TOKEN=""
POSTHOG_HOST="https://eu.i.posthog.com"
LOG_LEVEL="info"
