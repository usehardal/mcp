# Local stdio development:
#   npm run build && node --env-file=.env dist/index.js
# Both values come from your Hardal dashboard.

HARDAL_SIGNAL_ID=your-signal-id
HARDAL_SIGNAL_TOKEN=your-signal-token

# Optional (defaults shown):
# HARDAL_API_BASE_URL=https://api.nexus.usehardal.com
# HARDAL_REQUEST_TIMEOUT_MS=30000
