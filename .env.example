NODE_ENV="development"
PORT="1922"

# Beacon OAuth: public issuer advertised in metadata, and where this server calls Beacon.
OAUTH_ISSUER="http://localhost:1919"
BEACON_API_URL="http://localhost:1919"

# This server's resource identifier (token A audience) and the Reports API audience (token B).
MCP_RESOURCE="http://localhost:1922/mcp"
REPORTS_API_RESOURCE="http://localhost:1919/v1"

# Report requests per authenticated user per minute, per MCP replica (minimum 2).
MCP_REPORTS_RATE_LIMIT_PER_MINUTE="300"
MCP_REPORT_SELECTION_KEY=""

# MCP service identity (private_key_jwt) for introspection and token exchange.
SERVICE_CLIENT_ID="hardal-mcp"
# Local dev only: path to the private JWK generated by service-identity:generate.
SERVICE_PRIVATE_JWK_PATH="keys/private.jwk.json"
# Production: read the private key from Azure Key Vault instead of a file.
# SERVICE_PRIVATE_JWK_VAULT_URL="https://hardal-vault.vault.azure.net/secrets/hardal-mcp-service-key"
