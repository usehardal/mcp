{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      { "command": "node .agents/hooks/guard.mjs", "timeout": 10 }
    ],
    "beforeReadFile": [
      { "command": "node .agents/hooks/guard.mjs", "timeout": 10 }
    ],
    "stop": [
      { "command": "node .agents/hooks/stop-typecheck.mjs", "timeout": 300, "loop_limit": 3 }
    ]
  }
}
